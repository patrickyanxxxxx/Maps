#!name =  iRingo: 🗺️ Maps International-All Test v3
#!desc = Egern 优先测试版本的 Surge 兼容模块：大陆图层前置的 tileSet 顺序 + 单一国际卫星选择器与大陆坐标请求路由
#!author = patrickyanxxxxx; VirgilClyne
#!homepage = https://github.com/patrickyanxxxxx/Maps
#!icon = https://developer.apple.com/assets/elements/icons/maps/maps-128x128.png
#!category =  iRingo
#!version = 6.4.0-test.22-mainland-first-order
#!arguments = GeoManifest.Dynamic.Config.CountryCode:"US",UrlInfoSet.Dispatcher:"AutoNavi",UrlInfoSet.Directions:"AutoNavi",UrlInfoSet.RAP:"Apple",UrlInfoSet.LocationShift:"AutoNavi",TileSet.Earth:"AutoNavi",TileSet.Flyover:"XX",TileSet.Map:"CN",TileSet.Munin:"XX",TileSet.POI:"CN",TileSet.Roads:"XX",TileSet.Satellite:"ROUTE",Hybrid.MainlandWhitelist:"NATIVE",TileSet.Traffic:"CN",Config.Announcements.Environment:"CN",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = \nGeoManifest.Dynamic.Config.CountryCode: [动态配置] 请求身份\n    ├ US: 国际请求身份并预热 CN 清单缓存；与稳定版一致的已验证身份路径（默认，test20）\n    ├ AUTO: 根据设备地区选择请求身份并预热另一份清单\n    └ CN: 国内请求身份，仅用于回退诊断\nUrlInfoSet.RAP: [URL信息集] 评分、照片与反馈\n    └ Apple: 使用国际 RAP 服务（默认）\n固定实验逻辑:\n    ├ 主组保持 US 监管身份，恢复全球卫星、3D 与可交互四处看看\n    ├ 单一国际卫星选择器；大陆 style=98 请求由 satellite-route.js 按坐标改写到 CN 端点\n    ├ 国内标准底图、POI、交通、导航和定位继续使用高德服务\n    └ Storage=Argument，避免旧持久化参数覆盖

[Rule]
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gsp76-cn-ssl.ls.apple.com,DIRECT
DOMAIN-SUFFIX,is.autonavi.com,DIRECT

[Script]
# 仅处理 GEO 功能开关，不拦截天气、导航、ETA、交通或语音响应。
🗺️ InternationalAllV3.config.defaults.response = type=http-response, pattern=^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v3/modules/test/international-all-v3/assets/response.bundle.js?v=6.4.0-test.22-mainland-first-order, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&Hybrid.MainlandWhitelist="{{{Hybrid.MainlandWhitelist}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 请求改写为 US 国际身份并预热 CN 清单；输出使用国际原生主组并加入中国区域图层。
🗺️ InternationalAllV3.geo_manifest.request = type=http-request, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v3/modules/test/international-all-v3/assets/request.bundle.js?v=6.4.0-test.22-mainland-first-order, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&Hybrid.MainlandWhitelist="{{{Hybrid.MainlandWhitelist}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🗺️ InternationalAllV3.geo_manifest.response = type=http-response, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, requires-body=1, binary-body-mode=1, engine=webview, max-size=2097152, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v3/modules/test/international-all-v3/assets/response.bundle.js?v=6.4.0-test.22-mainland-first-order, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&Hybrid.MainlandWhitelist="{{{Hybrid.MainlandWhitelist}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 大陆 style=98 卫星瓦片按坐标改写到 CN 端点；国外请求保持不变。
🗺️ InternationalAllV3.satellite-route.request = type=http-request, pattern=^https?:\/\/gspe11-ssl\.ls\.apple\.com\/tile, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v3/modules/test/international-all-v3/assets/satellite-route.js?v=6.4.0-test.22-mainland-first-order

[MITM]
hostname = %APPEND% configuration.ls.apple.com, gspe35-ssl.ls.apple.com, gspe35-ssl.ls.apple.cn, gspe11-ssl.ls.apple.com
