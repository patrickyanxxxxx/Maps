#!name =  iRingo: 🗺️ Maps International-All Test v2
#!desc = Egern 优先测试版本的 Surge 兼容模块：国际原生主组承载国外能力，CN 图层仅在中国范围优先
#!author = patrickyanxxxxx; VirgilClyne
#!homepage = https://github.com/patrickyanxxxxx/Maps
#!icon = https://developer.apple.com/assets/elements/icons/maps/maps-128x128.png
#!category =  iRingo
#!version = 6.4.0-test.22-cache-self-healing
#!arguments = GeoManifest.Dynamic.Config.CountryCode:"CN",UrlInfoSet.Dispatcher:"AutoNavi",UrlInfoSet.Directions:"AutoNavi",UrlInfoSet.RAP:"Apple",UrlInfoSet.LocationShift:"AutoNavi",TileSet.Earth:"AutoNavi",TileSet.Flyover:"XX",TileSet.Map:"CN",TileSet.Munin:"XX",TileSet.POI:"CN",TileSet.Roads:"XX",TileSet.Satellite:"HYBRID",TileSet.Traffic:"CN",Config.Announcements.Environment:"CN",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = \nGeoManifest.Dynamic.Config.CountryCode: [动态配置] 请求身份\n    ├ CN: 使用国内服务与 CN 发布身份，并预热国际清单（默认，test22）\n    ├ AUTO: 根据设备地区选择请求身份并预热另一份清单\n    └ US: 国际请求身份，仅用于回退诊断\nUrlInfoSet.RAP: [URL信息集] 评分、照片与反馈\n    └ Apple: 使用国际 RAP 服务（默认）\n固定实验逻辑:\n    ├ 国际清单缓存缺失时自动补取并继续合并\n    ├ 主组保持 US 监管身份，恢复全球卫星、3D 与可交互四处看看\n    ├ 国际卫星及 Munin/SPR/道路能力选择器优先，CN 卫星仅作为大陆回退\n    ├ 国内标准底图、POI、交通、导航和定位继续使用高德服务\n    ├ 不执行瓦片请求改写，避免签名错误和慢加载\n    └ Storage=Argument，避免旧持久化参数覆盖

[Rule]
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gsp76-cn-ssl.ls.apple.com,DIRECT
DOMAIN-SUFFIX,is.autonavi.com,DIRECT

[Script]
# 仅处理 GEO 功能开关，不拦截天气、导航、ETA、交通或语音响应。
🗺️ InternationalAllV2.config.defaults.response = type=http-response, pattern=^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/response.bundle.js?v=6.4.0-test.22-cache-self-healing, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 请求保持 CN 国内服务语义；输出使用国际原生主组并加入中国区域图层。
🗺️ InternationalAllV2.geo_manifest.request = type=http-request, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/request.bundle.js?v=6.4.0-test.22-cache-self-healing, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🗺️ InternationalAllV2.geo_manifest.response = type=http-response, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, requires-body=1, binary-body-mode=1, engine=webview, max-size=2097152, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/response.bundle.js?v=6.4.0-test.22-cache-self-healing, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% configuration.ls.apple.com, gspe35-ssl.ls.apple.com, gspe35-ssl.ls.apple.cn
