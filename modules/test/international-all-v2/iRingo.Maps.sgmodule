#!name =  iRingo: 🗺️ Maps International-All Test v2
#!desc = Egern 优先测试版本的 Surge 兼容模块：保留国内高德地图、POI、交通与导航，补充国际卫星、3D、Flyover、四处看看和全球道路能力；额外提供 Surge 国内道路增强
#!author = patrickyanxxxxx; VirgilClyne
#!homepage = https://github.com/patrickyanxxxxx/Maps
#!icon = https://developer.apple.com/assets/elements/icons/maps/maps-128x128.png
#!category =  iRingo
#!version = 6.4.0-test.8-cnroad2
#!arguments = GeoManifest.Dynamic.Config.CountryCode:"US",UrlInfoSet.Dispatcher:"AutoNavi",UrlInfoSet.Directions:"AutoNavi",UrlInfoSet.RAP:"Apple",UrlInfoSet.LocationShift:"AutoNavi",TileSet.Earth:"AutoNavi",TileSet.Flyover:"XX",TileSet.Map:"CN",TileSet.Munin:"XX",TileSet.POI:"CN",TileSet.Roads:"XX",TileSet.Satellite:"HYBRID",TileSet.Traffic:"CN",Config.Announcements.Environment:"CN",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = \nGeoManifest.Dynamic.Config.CountryCode: [动态配置] 清单主体\n    ├ US: 国际清单主体并保留原生 3D 索引与分组（默认，test8）\n    ├ AUTO: 保留设备当前 CN/国际分支并预热另一份清单\n    └ CN: 中国清单主体，仅用于兼容诊断\nUrlInfoSet.Dispatcher: [URL信息集] 地点与 POI\n    └ AutoNavi: 国内地点、搜索与 POI 使用高德（默认）\nUrlInfoSet.Directions: [URL信息集] 导航与 ETA\n    └ AutoNavi: US 主体下国内使用高德导航，国外能力保持 Apple 国际版（默认）\nUrlInfoSet.RAP: [URL信息集] 评分、照片与反馈\n    └ Apple: 使用国际 RAP 服务（默认）\nUrlInfoSet.LocationShift: [URL信息集] 坐标修正\n    └ AutoNavi: 中国大陆使用 GCJ-02 修正（默认）\nTileSet.Earth: [瓦片数据集] 地球底图\n    └ AutoNavi: CN 分支保留大陆地球/标准资源（默认）\nTileSet.Flyover: [瓦片数据集] 3D 城市\n    └ XX: 国际 Flyover 与 3D 城市资源（默认）\nTileSet.Map / TileSet.POI / TileSet.Traffic: [瓦片数据集] 国内地图能力\n    └ CN: 保留高德底图、POI 与实时交通（默认）\nTileSet.Munin / TileSet.Roads: [瓦片数据集] 四处看看与道路能力\n    └ XX: 国际 Munin、SPR 与 Apple 道路选择器（默认）\nTileSet.Satellite: [瓦片数据集] 卫星图像\n    └ HYBRID: 国内外卫星并存；iOS 27 大陆 style 98 请求按坐标转 CN（默认）\nConfig.Announcements.Environment: [动态配置] 公告环境\n    └ CN: 使用中国公告环境（默认）\nStorage: [储存] 参数来源\n    └ Argument: 以模块参数为准，避免旧 BoxJs 值覆盖（默认）\nLogLevel: [调试] 日志等级\n    ├ WARN: 仅警告和错误（默认）\n    ├ INFO: 一般运行信息\n    └ DEBUG: 详细排错信息\n固定实验逻辑:\n    ├ US 原生 3D 描述符顺序与 tileGroup 索引保持不变\n    ├ 国内高德二维图层追加，不前插国际描述符\n    ├ 国际道路/环视选择器与国内高德服务隔离\n    ├ Surge z12-z15 大陆道路授权观察与按坐标重写\n    └ iOS 27 国内卫星 style 98/226 → style 7/68

[Rule]
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gsp76-cn-ssl.ls.apple.com,DIRECT
DOMAIN-SUFFIX,is.autonavi.com,DIRECT

[Script]
# 仅处理 GEO 功能开关，不拦截天气、导航、ETA、交通或语音响应。
🗺️ InternationalAllV2.config.defaults.response = type=http-response, pattern=^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/response.bundle.js?v=6.4.0-test.8-cnroad2, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 默认 US 主体；同时预热 CN 清单用于国内图层与服务注入。
🗺️ InternationalAllV2.geo_manifest.request = type=http-request, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/request.bundle.js?v=6.4.0-test.8-cnroad2, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🗺️ InternationalAllV2.geo_manifest.response = type=http-response, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, requires-body=1, binary-body-mode=1, engine=webview, max-size=2097152, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/response.bundle.js?v=6.4.0-test.8-cnroad2, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 观察高德道路授权；只在 z12-z15 的大陆坐标把国际 style 20 道路请求转为 CN 原生道路。
🧩 InternationalAllV2.cn.native-road-auth.observe = type=http-request, pattern=^https:\/\/gspe19(?:-2)?-cn-ssl\.ls\.apple\.com\/tiles(?:\?|$), requires-body=0, engine=jsc, timeout=3, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/cn-native-road.js?v=6.4.0-test.8-cnroad2
🧩 InternationalAllV2.cn.native-road.rewrite = type=http-request, pattern=^https:\/\/gspe19(?:-kittyhawk)?-ssl\.ls\.apple\.com\/tile\.vf(?:\?|$), requires-body=0, engine=jsc, timeout=3, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/cn-native-road.js?v=6.4.0-test.8-cnroad2

# 保留本项目在 iOS 27 实机验证过的国内卫星坐标路由。
🗺️ InternationalAllV2.ios27.satellite.route = type=http-request, pattern=^https:\/\/gspe11-ssl\.ls\.apple\.com\/tile(?:\?|$), requires-body=0, engine=jsc, timeout=3, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/satellite-route.js?v=6.4.0-test.8-cnroad2

[MITM]
hostname = %APPEND% configuration.ls.apple.com, gspe35-ssl.ls.apple.com, gspe35-ssl.ls.apple.cn, gspe11-ssl.ls.apple.com, gspe19-cn-ssl.ls.apple.com, gspe19-2-cn-ssl.ls.apple.com, gspe19-ssl.ls.apple.com, gspe19-kittyhawk-ssl.ls.apple.com
