#!name =  iRingo: 🗺️ Maps International-All Test v2
#!desc = Egern 优先测试版本的 Surge 兼容模块：CN 原生清单负责国内道路、POI 与定位；US 只追加国际卫星、3D、Flyover、四处看看和全球能力
#!author = patrickyanxxxxx; VirgilClyne
#!homepage = https://github.com/patrickyanxxxxx/Maps
#!icon = https://developer.apple.com/assets/elements/icons/maps/maps-128x128.png
#!category =  iRingo
#!version = 6.4.0-test.9-cn-native
#!arguments = GeoManifest.Dynamic.Config.CountryCode:"CN",UrlInfoSet.Dispatcher:"AutoNavi",UrlInfoSet.Directions:"AutoNavi",UrlInfoSet.RAP:"Apple",UrlInfoSet.LocationShift:"AutoNavi",TileSet.Earth:"AutoNavi",TileSet.Flyover:"XX",TileSet.Map:"CN",TileSet.Munin:"XX",TileSet.POI:"CN",TileSet.Roads:"XX",TileSet.Satellite:"HYBRID",TileSet.Traffic:"CN",Config.Announcements.Environment:"CN",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = \nGeoManifest.Dynamic.Config.CountryCode: [动态配置] 清单主体\n    ├ CN: 中国原生清单主体，国内道路、POI 与定位使用同一坐标语义（默认，test9）\n    ├ AUTO: 根据设备地区选择主体并预热另一份清单\n    └ US: 国际清单主体，仅用于诊断\nUrlInfoSet.RAP: [URL信息集] 评分、照片与反馈\n    └ Apple: 使用国际 RAP 服务（默认）\n固定实验逻辑:\n    ├ CN 原生 VECTOR_STANDARD、POI、建筑、道路、交通及定位服务保持不变\n    ├ US 国际卫星、3D、Flyover、Munin、SPR 与全球覆盖能力追加\n    ├ 不进行标准底图瓦片坐标改写\n    ├ 国内卫星 style 98/226 仍按原坐标路由到 CN style 7/68\n    └ Storage=Argument，避免旧持久化参数覆盖

[Rule]
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gsp76-cn-ssl.ls.apple.com,DIRECT
DOMAIN-SUFFIX,is.autonavi.com,DIRECT

[Script]
# 仅处理 GEO 功能开关，不拦截天气、导航、ETA、交通或语音响应。
🗺️ InternationalAllV2.config.defaults.response = type=http-response, pattern=^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/response.bundle.js?v=6.4.0-test.9-cn-native, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 默认 CN 主体；同时预热 US 清单用于国际能力追加。
🗺️ InternationalAllV2.geo_manifest.request = type=http-request, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/request.bundle.js?v=6.4.0-test.9-cn-native, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🗺️ InternationalAllV2.geo_manifest.response = type=http-response, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, requires-body=1, binary-body-mode=1, engine=webview, max-size=2097152, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/response.bundle.js?v=6.4.0-test.9-cn-native, argument=GeoManifest.Dynamic.Config.CountryCode="{{{GeoManifest.Dynamic.Config.CountryCode}}}"&UrlInfoSet.Dispatcher="{{{UrlInfoSet.Dispatcher}}}"&UrlInfoSet.Directions="{{{UrlInfoSet.Directions}}}"&UrlInfoSet.RAP="{{{UrlInfoSet.RAP}}}"&UrlInfoSet.LocationShift="{{{UrlInfoSet.LocationShift}}}"&TileSet.Earth="{{{TileSet.Earth}}}"&TileSet.Flyover="{{{TileSet.Flyover}}}"&TileSet.Map="{{{TileSet.Map}}}"&TileSet.Munin="{{{TileSet.Munin}}}"&TileSet.POI="{{{TileSet.POI}}}"&TileSet.Roads="{{{TileSet.Roads}}}"&TileSet.Satellite="{{{TileSet.Satellite}}}"&TileSet.Traffic="{{{TileSet.Traffic}}}"&Config.Announcements.Environment="{{{Config.Announcements.Environment}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# 保留本项目在 iOS 27 实机验证过的国内卫星坐标路由。
🗺️ InternationalAllV2.ios27.satellite.route = type=http-request, pattern=^https:\/\/gspe11-ssl\.ls\.apple\.com\/tile(?:\?|$), requires-body=0, engine=jsc, timeout=3, script-path=https://raw.githubusercontent.com/patrickyanxxxxx/Maps/test/international-all-v2/modules/test/international-all-v2/assets/satellite-route.js?v=6.4.0-test.9-cn-native

[MITM]
hostname = %APPEND% configuration.ls.apple.com, gspe35-ssl.ls.apple.com, gspe35-ssl.ls.apple.cn, gspe11-ssl.ls.apple.com
